{
  "name": "nebenk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "wasm:build": "cd ../crates/nebenk-wasm && wasm-pack build --target web --out-dir ../../web/public/wasm --no-typescript",
    "wasm:types": "cd ../crates/nebenk-wasm && wasm-pack build --target web --out-dir ../../web/public/wasm --typescript"
  },
  "dependencies": {
    "clsx": "2.1.0",
    "lucide-react": "0.378.0",
    "next": "14.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "2.2.0",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.0",
    "typescript": "5.3.3"
  }
}
